# Public-safe values only. NEVER put a Cloudinary api key or secret in this repo.
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=

# --- Course and article catalogue (server-side only, never exposed) ---
# These proxy Edvoy's internal Next.js data routes. The build id changes on
# every Edvoy deploy; when courses and articles go empty, that is why. Read it
# from a network request on edvoy.com (_next/data/<buildId>/...) and update.
# Leave unset and the Explore page shows a clear "not configured" state rather
# than breaking.
EDVOY_ORIGIN=https://edvoy.com
EDVOY_BUILD_ID=
